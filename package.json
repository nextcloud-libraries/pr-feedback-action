{
  "name": "pr-feedback-action",
  "version": "2.0.0",
  "private": true,
  "description": "Asks for feedback on PRs",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.app.json --noEmit && esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "format": "prettier --no-error-on-unmatched-pattern --config  ./.prettierrc.js --write \"**/*.{ts,yml,yaml}\"",
    "format-check": "prettier --no-error-on-unmatched-pattern --config ./.prettierrc.js --check \"**/*.{ts,yml,yaml}\"",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "lint:all": "npm run format-check && npm run lint",
    "lint:all:fix": "npm run format && npm run lint:fix",
    "test": "echo 'No tests'",
    "test:only-errors": "echo 'No tests'",
    "test:watch": "echo 'No tests'",
    "all": "npm run format && npm run lint && npm run build",
    "all:ci": "npm run format && npm run lint && npm run build",
    "prerelease": "npm run build",
    "release": "standard-version",
    "release:dry-run": "standard-version --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextcloud-libraries/pr-feedback-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "stale"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "author": "Nextcloud GmbH",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-retry": "^4.1.1",
    "lodash.deburr": "^4.1.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/lodash.deburr": "^4.1.6",
    "@types/node": "^24.19.1",
    "@types/semver": "^7.7.1",
    "ansi-styles": "5.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.13.0",
    "jest": "^29.5.0",
    "jest-circus": "^30.5.2",
    "jest-silent-reporter": "^0.5.0",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.8",
    "standard-version": "^9.5.0",
    "terminal-link": "^2.1.1",
    "ts-jest": "^29.0.5",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.71.0"
  }
}
